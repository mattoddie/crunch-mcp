# Copy to .env and fill in:  cp example.env .env
# Every option is explained in docs/configuration.md

# --- Crunch API -----------------------------------------------------------------
# From your Crunch API onboarding email (apply at https://developer.crunch.co.uk).
CRUNCH_CLIENT_ID=
# Only confidential clients get a secret. Public clients leave this empty and use PKCE.
CRUNCH_CLIENT_SECRET=
# Where the browser is sent after you click Allow. The default works with
# `crunch-mcp login`; it must match any redirect URI set on your API account.
# CRUNCH_REDIRECT_URI=http://127.0.0.1:8976/callback

# Tokens are saved here after `crunch-mcp login` (the image uses /data/tokens.json).
# Crunch rotates refresh tokens, so this file must be writable and persistent.
# CRUNCH_TOKEN_FILE=/data/tokens.json
# Alternatively, start from a refresh token you already have (it is replaced as it rotates):
# CRUNCH_REFRESH_TOKEN=

# Register tools that create or change records (expenses, invoices, clients, suppliers...).
CRUNCH_ALLOW_WRITES=false
# Also register tools that delete records (and let updates drop payments or attachments). Needs writes.
CRUNCH_ALLOW_DELETES=false
# Also register the tool that emails invoices to customers, and allow turning on
# Crunch's payment reminders (which email customers too). Needs writes.
CRUNCH_ALLOW_EMAIL=false
# A directory the server may read attachments from (file_path) and save downloads
# to (save_to). Unset, both are refused. In Docker, mount a folder there, e.g. ./files:/files
# CRUNCH_FILES_DIR=/files
# Record every call of a tool that changes things as JSON Lines: an absolute file
# path (created with mode 0600; its directory must exist and be writable) or stderr.
# In Docker, mount a writable folder, e.g. ./audit:/audit with CRUNCH_AUDIT_LOG=/audit/crunch-mcp.jsonl
# CRUNCH_AUDIT_LOG=
# Comma-separated toolsets to expose (default all). Fewer tools = less context for the model.
# account,reference,banking,clients,suppliers,expenses,recurring,invoices,raw
CRUNCH_TOOLSETS=all
# OAuth scopes requested at login. The default follows the settings above
# (read:all, plus create:all update:all with writes, delete:all with deletes, and offline_access).
# CRUNCH_SCOPES=
CRUNCH_TIMEOUT_MS=30000

# --- MCP transport ------------------------------------------------------------
# The image defaults to http. Use stdio for `docker run -i` from an MCP client.
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
# Required for http: clients must send "Authorization: Bearer <token>". The server
# won't start without it (minimum 16 characters). Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
# Only if something in front of the server already authenticates every request
# (then MCP_ALLOWED_HOSTS is required too):
# MCP_ALLOW_UNAUTHENTICATED=true
# Optional comma-separated host or host:port allow-list for the Host header (DNS
# rebinding protection). When set, browser requests from an Origin not on the list
# are refused too; for Origin, an entry without a port matches only port 443/80.
MCP_ALLOWED_HOSTS=
