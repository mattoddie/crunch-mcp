---
import logo from "../../../docs/assets/logo.svg?raw";
import { prompts, toolsets, totals } from "../lib/tools";

const GITHUB = "https://github.com/mattoddie/crunch-mcp";

// Illustrative month-to-date balances (£) for the hero chart, not real data. The chat's write
// records Acme's £5,400 payment, which lifts the last point.
const balances = [15320, 15320, 15134, 15134, 14634, 16834, 16834, 16620, 16620, 16620, 17340, 17340, 17100, 18450, 18420, 18420];
const paidIn = 5400;
const PLOT = { x0: 74, x1: 600, y0: 232, y1: 78, min: 12000, max: 25000 };
const px = (i: number) => PLOT.x0 + (i * (PLOT.x1 - PLOT.x0)) / (balances.length - 1);
const py = (v: number) => PLOT.y0 - ((v - PLOT.min) / (PLOT.max - PLOT.min)) * (PLOT.y0 - PLOT.y1);
const linePath = balances.map((v, i) => `${i ? "L" : "M"}${px(i).toFixed(1)} ${py(v).toFixed(1)}`).join(" ");
const areaPath = `${linePath} L${PLOT.x1} ${PLOT.y0} L${PLOT.x0} ${PLOT.y0} Z`;
const last = { x: px(balances.length - 1), y: py(balances.at(-1)!), yPaid: py(balances.at(-1)! + paidIn) };
const gbp = (v: number) => `£${v.toLocaleString("en-GB")}`;
const balanceNow = gbp(balances.at(-1)!);
const balancePaid = gbp(balances.at(-1)! + paidIn);
const gridLines = [15000, 20000, 25000].map((v) => ({ y: py(v), label: `£${v / 1000}k` }));
const dayTicks = [0, 7, 15].map((i) => ({ x: px(i), label: `${i + 1} Oct` }));

const title = "crunch-mcp: talk to your Crunch books";
const description =
  "An open-source MCP server for Crunch Accounting. Ask Claude and other AI assistants about your expenses, invoices, clients and bank accounts, and let them record receipts and raise invoices when you allow it. Runs in Docker.";

const toolsetIcons: Record<string, string> = {
  account: "🏢",
  reference: "📚",
  banking: "🏦",
  clients: "🤝",
  suppliers: "🚚",
  expenses: "🧾",
  recurring: "🔁",
  invoices: "📄",
  raw: "🧪",
};

const examples = [
  { icon: "🚆", q: "Record this receipt from the train station.", tools: ["list_expense_types", "list_suppliers", "create_expense"] },
  { icon: "⏰", q: "Which invoices are overdue and who should I chase?", tools: ["list_invoices", "get_client", "email_invoice"] },
  { icon: "💻", q: "How much did I spend on software this year?", tools: ["list_expense_types", "get_expenses_total"] },
  { icon: "📝", q: "Create an invoice for Acme for 5 days at £450.", tools: ["list_clients", "list_vat_types", "create_invoice"] },
  { icon: "📊", q: "Give me a summary of last quarter.", tools: ["get_invoice_totals", "get_expenses_total", "list_bank_accounts"] },
  { icon: "📎", q: "Are there any expenses missing receipts?", tools: ["list_expenses", "get_expense"] },
];

const features = [
  {
    icon: "🐳",
    title: "Docker-first",
    text: "A ~21 MB distroless image for amd64 and arm64. It runs as non-root on a read-only filesystem, and only the token volume is writable.",
  },
  {
    icon: "🔐",
    title: "OAuth handled",
    text: "Log in once with OAuth 2.0 and PKCE. Crunch rotates refresh tokens, so each new one is written safely to the volume and survives restarts.",
  },
  {
    icon: "🧷",
    title: "Careful updates",
    text: "Changes are read-modify-write: the current record is fetched and merged first, so Crunch never drops an expense's payments or attachments.",
  },
  {
    icon: "🧾",
    title: "Receipts and PDFs",
    text: "Attach receipt photos or PDFs to expenses and invoices, download them again, and fetch any sales invoice as a PDF.",
  },
  {
    icon: "🧭",
    title: "Lookups built in",
    text: "Expense types, VAT types, payment methods and open accounting periods are one call away, so the assistant uses values Crunch accepts.",
  },
  {
    icon: "🧪",
    title: "Tested against a mock Crunch",
    text: "The test suite runs the tools against a mock Crunch API, so changes are checked without going anywhere near real books.",
  },
];

const coverage = ["Expenses & receipts", "Sales invoices", "Clients", "Suppliers", "Recurring expenses", "Bank accounts", "Credit cards", "Company & VAT details"];
const clients = ["Claude Code", "Claude Desktop", "VS Code", "Cursor", "Codex", "Any MCP client"];

const raw = GITHUB.replace("github.com", "raw.githubusercontent.com");
const composeSnippet = `mkdir crunch-mcp && cd crunch-mcp
curl -fsSLO ${raw}/main/compose.yaml
curl -fsSL ${raw}/main/example.env -o .env
# set CRUNCH_CLIENT_ID (and CRUNCH_CLIENT_SECRET
# if you have one) and MCP_AUTH_TOKEN in .env
docker compose run --rm -p 8976:8976 crunch-mcp login
docker compose up -d`;
const connectSnippet = `claude mcp add --transport http crunch \\
  http://<docker-host>:8080/mcp \\
  --header "Authorization: Bearer <token>"`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#07100d" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.site} />
    <meta property="og:image" content={new URL("/og.png", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareSourceCode",
        name: "crunch-mcp",
        description,
        url: Astro.site?.href,
        codeRepository: GITHUB,
        license: "https://opensource.org/licenses/MIT",
        runtimePlatform: "Docker",
        author: { "@type": "Person", name: "Matt Oddie", url: "https://mattoddie.dev/" },
        isPartOf: { "@type": "WebSite", name: "MCP servers by Matt Oddie", url: "https://mcp.mattoddie.dev/" },
      })}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/" aria-label="crunch-mcp home">
          <span class="brand-logo" set:html={logo} />
          <span>crunch-mcp</span>
        </a>
        <nav aria-label="Main">
          <a href="/docs/">Docs</a>
          <a href="/docs/tools/">Tools</a>
          <a href="/docs/getting-started/" class="hide-sm">Get started</a>
          <a href="https://mcp.mattoddie.dev/" class="hide-sm">All servers</a>
          <a class="gh" href={GITHUB} aria-label="crunch-mcp on GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38v-1.33c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.87.87 2.33.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path></svg>
            <span class="hide-sm">GitHub</span>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <!-- Hero -->
      <section class="hero scene">
        <svg class="scene-sky" viewBox="0 0 1200 700" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
          <defs>
            <linearGradient id="link" x1="0" x2="1">
              <stop offset="0" stop-color="#84cc16" />
              <stop offset="0.55" stop-color="#10b981" />
              <stop offset="1" stop-color="#14b8a6" />
            </linearGradient>
          </defs>
          <!-- Ledger rules, with a running balance climbing faintly across them. -->
          <g class="rules">
            <path d="M0 160 H1200" /><path d="M0 260 H1200" /><path d="M0 360 H1200" /><path d="M0 460 H1200" />
          </g>
          <g class="links">
            <path d="M60 470 L240 400 L400 430 L580 330 L760 360 L940 230 L1140 160" />
            <path d="M240 400 L300 250 L520 190 L580 330" />
          </g>
          <g class="nodes">
            <circle cx="60" cy="470" r="4" /><circle cx="240" cy="400" r="6" /><circle cx="580" cy="330" r="7" />
            <circle cx="940" cy="230" r="6" /><circle cx="1140" cy="160" r="5" /><circle cx="300" cy="250" r="4" /><circle cx="520" cy="190" r="5" />
          </g>
        </svg>
        <div class="scene-desk" aria-hidden="true"></div>

        <!-- The books on the desk: the chat steps switch their states. -->
        <div class="scene-art" aria-hidden="true">
          <svg class="s-chart" viewBox="0 0 660 290">
            <defs>
              <linearGradient id="bal-line" x1="0" x2="1">
                <stop offset="0" stop-color="#84cc16" />
                <stop offset="0.55" stop-color="#10b981" />
                <stop offset="1" stop-color="#14b8a6" />
              </linearGradient>
              <linearGradient id="bal-area" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#10b981" stop-opacity="0.35" />
                <stop offset="1" stop-color="#10b981" stop-opacity="0" />
              </linearGradient>
            </defs>
            <rect class="card" x="1" y="1" width="658" height="288" rx="20" />
            <text class="c-title" x="26" y="40">Business account</text>
            <text class="c-sub" x="26" y="60">October, month to date</text>
            <text class="bal now" x="634" y="46" text-anchor="end">{balanceNow}</text>
            <text class="bal paid" x="634" y="46" text-anchor="end">{balancePaid}</text>
            <g class="grid">
              {gridLines.map((g) => (
                <>
                  <line x1={PLOT.x0} x2={PLOT.x1 + 14} y1={g.y} y2={g.y} />
                  <text x={PLOT.x0 - 10} y={g.y + 4} text-anchor="end">{g.label}</text>
                </>
              ))}
              <line class="base" x1={PLOT.x0} x2={PLOT.x1 + 14} y1={PLOT.y0} y2={PLOT.y0} />
              {dayTicks.map((t) => <text x={t.x} y={PLOT.y0 + 22} text-anchor="middle">{t.label}</text>)}
            </g>
            <path class="area" d={areaPath} />
            <path class="line" d={linePath} pathLength="1" />
            <circle class="end" cx={last.x} cy={last.y} r="5" />
            <g class="jump">
              <path d={`M${last.x} ${last.y} V${last.yPaid}`} pathLength="1" />
              <circle cx={last.x} cy={last.yPaid} r="6" />
              <text x={last.x - 12} y={last.yPaid + 5} text-anchor="end">+{gbp(paidIn)} Acme</text>
            </g>
            <text class="caption" x="634" y="276" text-anchor="end">example data</text>
          </svg>

          <svg class="s-inv" viewBox="0 0 280 290">
            <g class="paper back" transform="translate(34 -4) rotate(2 120 80)">
              <rect width="226" height="200" rx="12" />
              <text class="p-id" x="20" y="34">INV-0044</text>
              <text class="p-amt-s" x="206" y="34" text-anchor="end">£1,020</text>
            </g>
            <g class="paper back" transform="translate(12 46) rotate(-2 120 80)">
              <rect width="226" height="200" rx="12" />
              <text class="p-id" x="20" y="34">INV-0043</text>
              <text class="p-amt-s" x="206" y="34" text-anchor="end">£720</text>
            </g>
            <g class="paper" transform="translate(24 88)">
              <rect width="232" height="200" rx="12" />
              <text class="p-kicker" x="20" y="32">INVOICE</text>
              <text class="p-id" x="20" y="56">INV-0042</text>
              <text class="p-who" x="20" y="78">Acme Ltd · consulting</text>
              <line class="p-rule" x1="20" x2="212" y1="96" y2="96" />
              <text class="p-amt" x="20" y="134">£5,400</text>
              <text class="p-due" x="20" y="176">Due 12 Sep</text>
              <text class="p-paid" x="20" y="176">Paid 15 Oct</text>
              <g transform="translate(156 162) rotate(-10)">
                <g class="stamp overdue"><rect x="-56" y="-19" width="112" height="38" rx="6" /><text y="7" text-anchor="middle">OVERDUE</text></g>
                <g class="stamp paid"><rect x="-44" y="-19" width="88" height="38" rx="6" /><text y="7" text-anchor="middle">PAID</text></g>
              </g>
            </g>
          </svg>

          <svg class="s-exp" viewBox="0 0 240 290">
            <g class="paper back" transform="translate(14 8) rotate(-4 106 70)">
              <rect width="212" height="150" rx="12" />
              <text class="p-kicker" x="18" y="30">EXPENSE</text>
              <text class="p-id" x="18" y="54">Adobe</text>
              <text class="p-who" x="18" y="74">Software · £56.99</text>
              <path class="slip" d="M146 22 H192 V96 l-5.75 -6 l-5.75 6 l-5.75 -6 l-5.75 6 l-5.75 -6 l-5.75 6 l-5.75 -6 l-5.75 6 Z" />
              <path class="slip-line" d="M154 38 H184 M154 50 H178 M154 62 H184 M154 78 H172" />
              <path class="clip ok" d="M158 34 V10 a6 6 0 0 1 12 0 V38 a3.5 3.5 0 0 1 -7 0 V16" />
              <circle class="tick-bg" cx="192" cy="96" r="11" />
              <path class="tick" d="M186.5 96.5 l3.8 3.8 l7 -7.6" />
            </g>
            <g class="paper" transform="translate(14 112)">
              <rect width="212" height="166" rx="12" />
              <text class="p-kicker" x="18" y="30">EXPENSE</text>
              <text class="p-id" x="18" y="54">LNER</text>
              <text class="p-who" x="18" y="74">Train fare · 3 Oct</text>
              <text class="p-amt-s" x="18" y="106">£186.00</text>
              <rect class="slot" x="142" y="22" width="52" height="72" rx="6" />
              <path class="clip missing" d="M162 34 V18 a6 6 0 0 1 12 0 V44" />
              <g class="warn">
                <rect x="10" y="124" width="192" height="30" rx="15" />
                <circle cx="30" cy="139" r="9" />
                <text class="bang" x="30" y="143.5" text-anchor="middle">!</text>
                <text x="48" y="144">missing receipt</text>
              </g>
            </g>
          </svg>
        </div>

        <div class="wrap hero-grid">
          <div class="hero-copy">
            <p class="eyebrow"><span class="dot"></span> Open source · MIT · Model Context Protocol</p>
            <h1>Talk to your <span class="grad">Crunch books.</span></h1>
            <p class="lede">
              crunch-mcp connects Claude and other AI assistants to Crunch Accounting. Ask about expenses, invoices, clients and bank
              accounts in plain English, and let the assistant record receipts and raise invoices when you allow it.
            </p>
            <div class="cta">
              <a class="btn primary" href="/docs/getting-started/">Get started <span aria-hidden="true">→</span></a>
              <a class="btn ghost" href={GITHUB}>Star on GitHub</a>
            </div>
            <div class="pull">
              <code>docker pull ghcr.io/mattoddie/crunch-mcp</code>
              <button class="copy" data-copy="docker pull ghcr.io/mattoddie/crunch-mcp" aria-label="Copy command">Copy</button>
            </div>
          </div>

          <div class="chat" aria-label="Example conversation">
            <div class="chat-bar"><span></span><span></span><span></span><em>Claude · crunch · writes on</em></div>
            <div class="chat-body" id="chat">
              <div class="msg user" data-step="0">How's the business looking this month?</div>
              <div class="calls" data-step="1">
                <span class="call"><i></i>crunch_list_bank_accounts<b>balances</b></span>
                <span class="call"><i></i>crunch_list_invoices<b>unpaid</b></span>
                <span class="call"><i></i>crunch_list_expenses<b>October</b></span>
              </div>
              <div class="msg bot" data-step="2">
                Pretty good. The business account is at <mark>£18,420</mark>, up £3,100 this month. Three invoices are unpaid
                (<mark>£7,140</mark>), and Acme's <strong>INV-0042</strong> for £5,400 is <mark>34 days overdue</mark>. One expense, a £186
                train fare, is missing its receipt.
              </div>
              <div class="msg user" data-step="3">Acme paid that yesterday. Can you record it?</div>
              <div class="calls" data-step="4">
                <span class="call write"><i></i>crunch_add_invoice_payment<b>INV-0042 · £5,400</b></span>
              </div>
              <div class="msg bot" data-step="5">
                Recorded. INV-0042 is now <mark>paid</mark>, £5,400 on 15 October, and the business account shows
                <mark>£23,820</mark>. The other two invoices, £1,740, aren't due yet.
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Stats -->
      <section class="stats wrap" aria-label="At a glance">
        <div><strong>{totals.tools}</strong><span>tools</span></div>
        <div><strong>{totals.toolsets}</strong><span>toolsets</span></div>
        <div><strong>{totals.prompts}</strong><span>guided prompts</span></div>
        <div><strong>~21 MB</strong><span>distroless image</span></div>
      </section>

      <!-- Examples -->
      <section class="section wrap">
        <div class="section-head">
          <p class="kicker">Ask anything</p>
          <h2>Your books, in plain English.</h2>
          <p>
            The assistant picks the right tools, runs them against Crunch's public API and explains what it found. No exporting
            spreadsheets or clicking through screens to find a number.
          </p>
        </div>
        <div class="examples">
          {
            examples.map((e) => (
              <article class="example">
                <span class="ex-icon" aria-hidden="true">{e.icon}</span>
                <p>“{e.q}”</p>
                <div class="ex-tools">
                  {e.tools.map((t) => (
                    <code>{t}</code>
                  ))}
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Toolsets -->
      <section class="section wrap" id="toolsets">
        <div class="section-head">
          <p class="kicker">Full coverage</p>
          <h2>{totals.tools} tools across Crunch's public API.</h2>
          <p>
            Grouped into {totals.toolsets} toolsets you can switch on and off, so the assistant only sees what you need: {`${totals.read} read, ${totals.write} write, ${totals.delete} delete and ${totals.email} email ${totals.email === 1 ? "tool" : "tools"}.`}
          </p>
        </div>
        <div class="toolsets">
          {
            toolsets.map((t) => (
              <a class="toolset" href={`/docs/tools/#${t.name}`}>
                <div class="ts-top">
                  <span class="ts-icon" aria-hidden="true">{toolsetIcons[t.name] ?? "🔧"}</span>
                  <code>{t.name}</code>
                  <span class="ts-count">{t.total}</span>
                </div>
                <p>{t.summary}</p>
                <div class="ts-bar" role="img" aria-label={`${t.read} read, ${t.write} write, ${t.delete} delete, ${t.email} email`}>
                  <span class="r" style={`flex:${t.read}`} />
                  <span class="w" style={`flex:${t.write}`} />
                  <span class="d" style={`flex:${t.delete}`} />
                  <span class="e" style={`flex:${t.email}`} />
                </div>
              </a>
            ))
          }
        </div>
        <p class="legend">
          <span class="r"></span>read <span class="w"></span>write <span class="d"></span>delete <span class="e"></span>email ·
          <a href="/docs/tools/">Full tool reference →</a>
        </p>
      </section>

      <!-- Safety -->
      <section class="section safety-wrap">
        <div class="wrap safety">
          <div class="section-head left">
            <p class="kicker">Safe by default</p>
            <h2>It can look. It only touches your books when you say so.</h2>
            <p>
              Tools that aren't allowed aren't registered at all. The assistant can't see them, so it can't call them or be talked into
              calling them.
            </p>
            <ul class="checks">
              <li><strong>Read-only out of the box.</strong> Writes, deletes and emailing your customers are three separate switches.</li>
              <li><strong>Least-privilege OAuth scopes.</strong> Login asks Crunch only for what your settings need, so a read-only setup gets a read-only token.</li>
              <li><strong>Destructive tools are labelled,</strong> so your client asks before running them.</li>
              <li><strong>Bearer-token auth</strong>, a Host allow-list and a read-only, non-root container.</li>
            </ul>
            <a class="link" href="/docs/security/">Read the security model →</a>
          </div>
          <div class="levels" aria-label="Access levels">
            <div class="level on">
              <div class="lv-head"><span class="pill r">read</span><span class="switch on" aria-hidden="true"></span></div>
              <p><strong>{totals.read} tools</strong>, always on</p>
              <code>list_invoices · get_expenses_total · get_overview …</code>
            </div>
            <div class="level">
              <div class="lv-head"><span class="pill w">write</span><span class="switch" aria-hidden="true"></span></div>
              <p><strong>{totals.write} tools</strong> with <code>CRUNCH_ALLOW_WRITES=true</code></p>
              <code>create_expense · create_invoice · issue_invoice · add_invoice_payment …</code>
            </div>
            <div class="level">
              <div class="lv-head"><span class="pill d">delete</span><span class="switch" aria-hidden="true"></span></div>
              <p><strong>{totals.delete} tools</strong> with <code>CRUNCH_ALLOW_DELETES=true</code> as well</p>
              <code>delete_expense · delete_invoice · remove_invoice_payment …</code>
            </div>
            <div class="level">
              <div class="lv-head"><span class="pill e">email</span><span class="switch" aria-hidden="true"></span></div>
              <p><strong>{totals.email} {totals.email === 1 ? "tool" : "tools"}</strong> with <code>CRUNCH_ALLOW_EMAIL=true</code> as well</p>
              <code>email_invoice, which sends invoices to your customers</code>
            </div>
          </div>
        </div>
      </section>

      <!-- Features -->
      <section class="section wrap">
        <div class="section-head">
          <p class="kicker">Built with care</p>
          <h2>The fiddly parts, handled.</h2>
